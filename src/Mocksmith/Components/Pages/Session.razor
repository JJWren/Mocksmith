@page "/sessions/{SessionId:guid}"
@using System.Text.Json
@using Microsoft.EntityFrameworkCore
@using Mocksmith.Core.Data
@using Mocksmith.Core.Entities
@using Mocksmith.Core.Generation
@using Mocksmith.Core.Services
@inject DraftSessionService Sessions
@inject IDbContextFactory<MocksmithDbContext> ContextFactory
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Draft session — Mocksmith</PageTitle>

@if (_session is null)
{
    <p class="muted">@(_loaded ? "Session not found." : "Loading…")</p>
}
else
{
    <div class="session-page">
        <aside class="session-sidebar">
            <h2>Iterations</h2>
            @if (_session.Iterations.Count == 0 && !_generating)
            {
                <p class="muted">None yet.</p>
            }
            <ul>
                @foreach (var iteration in _session.Iterations.OrderBy(i => i.Index))
                {
                    <li>
                        <button type="button"
                                class="iteration-item @(iteration.Id == _selectedId ? "iteration-on" : "")"
                                @onclick="() => SelectAsync(iteration.Id)">
                            <span class="iteration-title">
                                #@iteration.Index @(iteration.InstructionText is null ? $"· candidate {(char)('A' + iteration.CandidateGroup)}" : "· refine")
                            </span>
                            <span class="iteration-sub">
                                @(iteration.InstructionText ?? iteration.Name ?? "")
                            </span>
                        </button>
                    </li>
                }
            </ul>
            <div class="session-meta muted">
                <div>Model: @_session.Model</div>
                @if (_session.SourceUrl is not null)
                {
                    <div>Source: @_session.SourceUrl</div>
                }
            </div>
        </aside>

        <section class="session-main">
            <div class="session-toolbar">
                <input class="refine-input"
                       placeholder="Refine: e.g. darker header, more whitespace, serif headings…"
                       @bind="_refineText"
                       @bind:event="oninput"
                       disabled="@(_generating || _selectedId is null)" />
                <button type="button" @onclick="RefineAsync" disabled="@(_generating || _selectedId is null || string.IsNullOrWhiteSpace(_refineText))">
                    Refine
                </button>
                <button type="button"
                        class="@(_editMode ? "edit-toggle-on" : "")"
                        @onclick="ToggleEditModeAsync"
                        disabled="@(_generating || _selectedId is null)">
                    @(_editMode ? "Exit edit" : "Edit elements")
                </button>
                <button type="button" class="save-button" @onclick="OpenSaveDialog" disabled="@(_generating || _selectedId is null)">
                    Save as sample…
                </button>
            </div>

            @if (_generating)
            {
                <div class="generation-status">
                    <div class="spinner"></div>
                    <span>@(_phase ?? "generating…") · @(_elapsed)s</span>
                </div>
            }
            @if (_error is not null)
            {
                <p class="form-error" role="alert">@_error</p>
            }

            <div class="session-workspace">
                @if (_selectedId is { } selected)
                {
                    <div class="session-preview">
                        <iframe id="workspace-frame"
                                title="Draft preview"
                                src="/sessions/@SessionId/iterations/@selected/file@(_editMode ? "?bridge=true" : "")"
                                sandbox="allow-scripts"></iframe>
                    </div>
                }

                @if (_editMode)
                {
                    <aside class="edit-panel">
                        <h2>Direct edit</h2>
                        <p class="muted panel-hint">
                            Click an element in the preview. Edits target the element's rule
                            (its class or tag), so all similar elements update together.
                        </p>

                        @if (_selection is { } selection)
                        {
                            <div class="panel-section">
                                <h3>Rule <code>@selection.Selector</code></h3>
                                <label>Font family
                                    <input value="@RuleValue(selection, "font-family")"
                                           @onchange='e => SetRuleAsync(selection.Selector, "font-family", e.Value?.ToString())' />
                                </label>
                                <label>Font size
                                    <input value="@RuleValue(selection, "font-size")"
                                           @onchange='e => SetRuleAsync(selection.Selector, "font-size", e.Value?.ToString())' />
                                </label>
                                <label>Font weight
                                    <select value="@RuleValue(selection, "font-weight")"
                                            @onchange='e => SetRuleAsync(selection.Selector, "font-weight", e.Value?.ToString())'>
                                        @foreach (var weight in FontWeights)
                                        {
                                            <option value="@weight">@weight</option>
                                        }
                                    </select>
                                </label>
                                <label>Text color
                                    <input value="@RuleValue(selection, "color")"
                                           @onchange='e => SetRuleAsync(selection.Selector, "color", e.Value?.ToString())' />
                                </label>
                                <label>Background
                                    <input value="@RuleValue(selection, "background-color")"
                                           @onchange='e => SetRuleAsync(selection.Selector, "background-color", e.Value?.ToString())' />
                                </label>
                            </div>
                        }

                        @if (_tokenValues.Count > 0)
                        {
                            <div class="panel-section">
                                <h3>Design tokens</h3>
                                @foreach (var token in _tokenValues.Keys.OrderBy(k => k, StringComparer.Ordinal).ToList())
                                {
                                    <label class="token-row">
                                        <span class="token-name">@token</span>
                                        <input value="@_tokenValues[token]"
                                               @onchange="e => SetTokenAsync(token, e.Value?.ToString())" />
                                    </label>
                                }
                            </div>
                        }

                        <div class="panel-actions">
                            <button type="button" class="link-button" @onclick="ResetEditsAsync" disabled="@_patch.IsEmpty">Reset edits</button>
                            <button type="button" @onclick="ApplyEditsAsync" disabled="@(_patch.IsEmpty || _generating)">Apply as new iteration</button>
                        </div>
                    </aside>
                }
            </div>
        </section>
    </div>

    @if (_showSaveDialog)
    {
        <div class="modal-backdrop" @onclick="CloseSaveDialog">
            <div class="modal" @onclick:stopPropagation="true">
                <h2>Save</h2>
                @if (_originSampleName is not null)
                {
                    <div class="save-mode-group" role="radiogroup" aria-label="Save mode">
                        <label class="save-mode">
                            <input type="radio" name="save-mode" value="variant"
                                   checked="@(_saveMode == "variant")"
                                   @onchange='() => _saveMode = "variant"' />
                            Save as variant of <strong>@_originSampleName</strong>
                        </label>
                        <label class="save-mode">
                            <input type="radio" name="save-mode" value="overwrite"
                                   checked="@(_saveMode == "overwrite")"
                                   @onchange='() => _saveMode = "overwrite"' />
                            Overwrite <strong>@_originSampleName</strong>
                        </label>
                        <label class="save-mode">
                            <input type="radio" name="save-mode" value="new"
                                   checked="@(_saveMode == "new")"
                                   @onchange='() => _saveMode = "new"' />
                            New sample
                        </label>
                    </div>
                }

                @if (_saveMode == "variant" && _originSampleName is not null)
                {
                    <label>
                        Variant name <span class="muted">(an existing name is overwritten)</span>
                        <input @bind="_variantName" maxlength="100" placeholder="Dark, Compact, Serif…" />
                    </label>
                }
                else
                {
                    <label>
                        Name
                        <input @bind="_saveName" maxlength="200" />
                    </label>
                }
                @if (_saveMode != "variant" || _originSampleName is null)
                {
                <label>
                    Summary
                    <textarea @bind="_saveSummary" maxlength="1000" rows="2"></textarea>
                </label>
                <label>Tags</label>
                }
                @if (_saveMode != "variant" || _originSampleName is null)
                {
                <div class="tag-chips">
                    @foreach (var tag in _saveTags)
                    {
                        <span class="chip">
                            @tag
                            <button type="button" class="chip-remove" @onclick="() => _saveTags.Remove(tag)">×</button>
                        </span>
                    }
                </div>
                <div class="tag-add-row">
                    <input placeholder="add tag" @bind="_newTag" />
                    <button type="button" @onclick="AddTag">Add</button>
                </div>
                }
                @if (_saveError is not null)
                {
                    <p class="form-error" role="alert">@_saveError</p>
                }
                <div class="modal-actions">
                    <button type="button" class="link-button" @onclick="CloseSaveDialog">Cancel</button>
                    <button type="button" @onclick="SaveAsync" disabled="@_saving">@(_saving ? "Saving…" : "Save")</button>
                </div>
            </div>
        </div>
    }
}

@code {
    private static readonly string[] FontWeights = ["300", "400", "500", "600", "700", "800", "900"];

    [Parameter]
    public Guid SessionId { get; set; }

    [SupplyParameterFromQuery(Name = "fanout")]
    public int? Fanout { get; set; }

    private DraftSession? _session;
    private bool _loaded;
    private Guid? _selectedId;
    private bool _generating;
    private string? _phase;
    private int _elapsed;
    private string? _error;
    private string _refineText = "";
    private System.Timers.Timer? _elapsedTimer;
    private CancellationTokenSource? _workCts;
    private bool _disposed;

    private bool _editMode;
    private BridgeSelection? _selection;
    private readonly Dictionary<string, string> _tokenValues = new(StringComparer.Ordinal);
    private DesignPatch _patch = new();
    private DotNetObjectReference<Session>? _selfReference;

    private bool _showSaveDialog;
    private string _saveName = "";
    private string _saveSummary = "";
    private List<string> _saveTags = [];
    private string _newTag = "";
    private string? _saveError;
    private bool _saving;
    private string _saveMode = "new";
    private string _variantName = "";
    private string? _originSampleName;

    private sealed record BridgeSelection(string Selector, string Tag, Dictionary<string, string> Computed);

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        _loaded = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _selfReference = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("mocksmithWorkspace.init", _selfReference, "workspace-frame");

        // OnAfterRender only fires in the interactive circuit, so the fan-out kick-off
        // cannot double-run during prerender.
        if (Fanout is > 0 && _session is { Iterations.Count: 0 } && !_generating)
        {
            StartWork(ct => Sessions.GenerateCandidatesAsync(SessionId, Fanout!.Value, MakeProgress(), ct));
        }
    }

    [JSInvokable]
    public Task OnBridgeMessage(string json)
    {
        try
        {
            using var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;
            switch (root.GetProperty("type").GetString())
            {
                case "ms-ready":
                    _tokenValues.Clear();
                    if (root.TryGetProperty("tokens", out var tokens) && tokens.ValueKind == JsonValueKind.Object)
                    {
                        foreach (var property in tokens.EnumerateObject())
                        {
                            _tokenValues[property.Name] = property.Value.GetString() ?? "";
                        }
                    }

                    break;
                case "ms-selected":
                    var computed = new Dictionary<string, string>(StringComparer.Ordinal);
                    if (root.TryGetProperty("computed", out var computedElement) && computedElement.ValueKind == JsonValueKind.Object)
                    {
                        foreach (var property in computedElement.EnumerateObject())
                        {
                            computed[property.Name] = property.Value.GetString() ?? "";
                        }
                    }

                    _selection = new BridgeSelection(
                        root.GetProperty("selector").GetString() ?? "body",
                        root.TryGetProperty("tag", out var tag) ? tag.GetString() ?? "" : "",
                        computed);
                    break;
            }
        }
        catch (JsonException)
        {
            return Task.CompletedTask;
        }
        catch (KeyNotFoundException)
        {
            return Task.CompletedTask;
        }

        return InvokeAsync(StateHasChanged);
    }

    private async Task ToggleEditModeAsync()
    {
        _editMode = !_editMode;
        if (!_editMode)
        {
            _selection = null;
            _patch = new DesignPatch();
        }

        await Task.CompletedTask;
    }

    private string RuleValue(BridgeSelection selection, string property)
    {
        if (_patch.Rules.TryGetValue(selection.Selector, out var rule) && rule.TryGetValue(property, out var patched))
        {
            return patched;
        }

        var computedKey = property switch
        {
            "font-family" => "fontFamily",
            "font-size" => "fontSize",
            "font-weight" => "fontWeight",
            "background-color" => "backgroundColor",
            _ => property,
        };
        return selection.Computed.GetValueOrDefault(computedKey, "");
    }

    private async Task SetRuleAsync(string selector, string property, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        try
        {
            _patch.SetRule(selector, property, value);
        }
        catch (ArgumentException ex)
        {
            _error = ex.Message;
            return;
        }

        _error = null;
        await PushPatchAsync();
    }

    private async Task SetTokenAsync(string token, string? value)
    {
        if (value is null)
        {
            return;
        }

        try
        {
            _patch.SetToken(token, value);
            _tokenValues[token] = value;
        }
        catch (ArgumentException ex)
        {
            _error = ex.Message;
            return;
        }

        _error = null;
        await PushPatchAsync();
    }

    private Task PushPatchAsync()
        => JS.InvokeVoidAsync("mocksmithWorkspace.sendPatch", "workspace-frame", _patch.ToCss()).AsTask();

    private async Task ResetEditsAsync()
    {
        _patch = new DesignPatch();
        await JS.InvokeVoidAsync("mocksmithWorkspace.sendPatch", "workspace-frame", "");
    }

    private async Task ApplyEditsAsync()
    {
        if (_patch.IsEmpty)
        {
            return;
        }

        try
        {
            await Sessions.ApplyManualPatchAsync(SessionId, _patch.ToCss());
            _patch = new DesignPatch();
            _selection = null;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task ReloadAsync()
    {
        _session = await Sessions.GetSessionAsync(SessionId);
        var active = _session?.Iterations.FirstOrDefault(i => i.IsActive) ?? _session?.Iterations.OrderBy(i => i.Index).LastOrDefault();
        _selectedId = active?.Id;

        if (_session?.SourceSampleId is { } originId)
        {
            await using var db = await ContextFactory.CreateDbContextAsync();
            _originSampleName = await db.Samples.AsNoTracking()
                .Where(s => s.Id == originId)
                .Select(s => s.Name)
                .FirstOrDefaultAsync();
        }
        else
        {
            _originSampleName = null;
        }
    }

    private void StartWork(Func<CancellationToken, Task> work)
    {
        _generating = true;
        _error = null;
        _elapsed = 0;
        _workCts?.Dispose();
        _workCts = new CancellationTokenSource();
        var ct = _workCts.Token;
        _elapsedTimer?.Dispose();
        _elapsedTimer = new System.Timers.Timer(1000);
        _elapsedTimer.Elapsed += (_, _) =>
        {
            if (_disposed)
            {
                return;
            }

            _elapsed++;
            _ = InvokeAsync(StateHasChanged);
        };
        _elapsedTimer.Start();

        _ = Task.Run(async () =>
        {
            try
            {
                await work(ct);
                await ReloadAsync();
            }
            catch (OperationCanceledException)
            {
                // component disposed mid-generation; nothing to surface
            }
            catch (Exception ex)
            {
                _error = ex.Message;
            }
            finally
            {
                _generating = false;
                _phase = null;
                _elapsedTimer?.Stop();
                if (!_disposed)
                {
                    await InvokeAsync(StateHasChanged);
                }
            }
        });
    }

    private Progress<GenerationProgress> MakeProgress() => new(p =>
    {
        if (_disposed)
        {
            return;
        }

        _phase = p.Phase + (p.OutputTokensSoFar > 0 ? $" (~{p.OutputTokensSoFar} tokens)" : "");
        _ = InvokeAsync(StateHasChanged);
    });

    private async Task SelectAsync(Guid iterationId)
    {
        _selectedId = iterationId;
        _selection = null;
        await Sessions.SetActiveAsync(SessionId, iterationId);
    }

    private void RefineAsync()
    {
        var instruction = _refineText;
        _refineText = "";
        StartWork(ct => Sessions.RefineAsync(SessionId, instruction, MakeProgress(), ct));
    }

    private void OpenSaveDialog()
    {
        var iteration = _session?.Iterations.FirstOrDefault(i => i.Id == _selectedId);
        if (iteration is null)
        {
            return;
        }

        _saveName = iteration.Name ?? "";
        _saveSummary = iteration.Summary ?? "";
        _saveTags = ParseTags(iteration.TagsJson);
        _saveError = null;
        _saveMode = _originSampleName is null ? "new" : "variant";
        _variantName = _originSampleName is not null && iteration.Name != _originSampleName
            ? iteration.Name ?? ""
            : "";
        _showSaveDialog = true;
    }

    private void CloseSaveDialog() => _showSaveDialog = false;

    private void AddTag()
    {
        var normalized = TagNormalizer.Normalize(_newTag);
        if (normalized.Length > 0 && !_saveTags.Contains(normalized))
        {
            _saveTags.Add(normalized);
        }

        _newTag = "";
    }

    private async Task SaveAsync()
    {
        if (_selectedId is not { } iterationId)
        {
            return;
        }

        _saving = true;
        _saveError = null;
        try
        {
            switch (_saveMode)
            {
                case "overwrite" when _originSampleName is not null:
                    await Sessions.OverwriteOriginAsync(SessionId, iterationId, _saveName, _saveSummary, _saveTags);
                    break;
                case "variant" when _originSampleName is not null:
                    await Sessions.SaveAsVariantAsync(SessionId, iterationId, _variantName);
                    break;
                default:
                    await Sessions.SaveAsSampleAsync(SessionId, iterationId, _saveName, _saveSummary, _saveTags);
                    break;
            }

            Navigation.NavigateTo("/");
        }
        catch (Exception ex)
        {
            _saveError = ex.Message;
            _saving = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _workCts?.Cancel();
        _workCts?.Dispose();
        _elapsedTimer?.Dispose();
        try
        {
            await JS.InvokeVoidAsync("mocksmithWorkspace.dispose");
        }
        catch (JSDisconnectedException)
        {
            // The circuit is already torn down, which means the browser context and its
            // message listener were destroyed with it; there is nothing left to clean up.
        }
        finally
        {
            _selfReference?.Dispose();
        }
    }

    private static List<string> ParseTags(string? tagsJson)
    {
        if (string.IsNullOrWhiteSpace(tagsJson))
        {
            return [];
        }

        try
        {
            return (JsonSerializer.Deserialize<List<string>>(tagsJson) ?? [])
                .Select(TagNormalizer.Normalize)
                .Where(t => t.Length > 0)
                .Distinct()
                .ToList();
        }
        catch (JsonException)
        {
            return [];
        }
    }
}
