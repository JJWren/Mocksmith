@page "/"
@using Mocksmith.Core.Entities
@using Mocksmith.Core.Services
@inject SampleQueryService Queries
@inject DraftSessionService Sessions
@inject CollectionService Collections
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Mocksmith — Dashboard</PageTitle>

<div class="dashboard">
    @if (_collections.Count > 0)
    {
        <div class="collection-strip">
            @foreach (var entry in _collections)
            {
                <a class="collection-card" href="/collections/@entry.Collection.Id">
                    <strong>@entry.Collection.Name</strong>
                    <span class="muted">@entry.MemberCount</span>
                </a>
            }
            <a class="collection-card collection-card-new" href="/collections">+ collection</a>
        </div>
    }

    <div class="filter-bar">
        <input class="search-input"
               type="search"
               placeholder="Search name or summary…"
               value="@_searchText"
               @oninput="OnSearchInputAsync" />
        @if (_allTags.Count > 0)
        {
            <div class="tag-chips" role="group" aria-label="Filter by tag">
                @foreach (var tag in _allTags)
                {
                    var selected = _selectedTags.Contains(tag.Name);
                    <button type="button"
                            class="chip @(selected ? "chip-on" : "")"
                            aria-pressed="@selected"
                            @onclick="() => ToggleTagAsync(tag.Name)">@tag.Name</button>
                }
            </div>
        }
    </div>

    @if (_samples.Count == 0)
    {
        <div class="empty-state">
            <h2>No samples @(_filtered ? "match the current filter" : "yet")</h2>
            <p>
                @if (_filtered)
                {
                    <text>Clear the search or tag filters to see the full catalog.</text>
                }
                else
                {
                    <text><a href="/generate">Generate one</a> or <a href="/import">import one</a> to light the forge.</text>
                }
            </p>
        </div>
    }
    else
    {
        <div class="tile-grid">
            @foreach (var sample in _samples)
            {
                <article class="tile" @key="sample.Id">
                    <div class="tile-preview">
                        <iframe title="Preview of @sample.Name"
                                data-preview-src="/samples/@sample.Id/file"
                                sandbox="allow-scripts"
                                loading="lazy"
                                tabindex="-1"></iframe>
                    </div>
                    <div class="tile-body">
                        <div class="tile-title-row">
                            <h2>@sample.Name</h2>
                            <button type="button" class="tile-edit" title="Open in workspace"
                                    @onclick="() => EditSampleAsync(sample.Id)">Edit</button>
                        </div>
                        @if (sample.Variants.Count > 0)
                        {
                            <button type="button" class="variant-badge variant-toggle"
                                    aria-expanded="@_expandedTiles.Contains(sample.Id)"
                                    @onclick="() => ToggleVariants(sample.Id)">
                                @sample.Variants.Count variant@(sample.Variants.Count == 1 ? "" : "s") @(_expandedTiles.Contains(sample.Id) ? "▾" : "▸")
                            </button>
                            @if (_expandedTiles.Contains(sample.Id))
                            {
                                <ul class="variant-list">
                                    @foreach (var variant in sample.Variants.OrderBy(v => v.Name))
                                    {
                                        <li class="variant-row">
                                            <span class="variant-name">@variant.Name</span>
                                            <span class="muted variant-date">@variant.UpdatedAt.ToString("MMM d")</span>
                                            <button type="button" class="tile-edit"
                                                    @onclick="() => EditVariantAsync(variant.Id)">Edit</button>
                                        </li>
                                    }
                                </ul>
                            }
                        }
                        @if (!string.IsNullOrWhiteSpace(sample.Summary))
                        {
                            <p class="tile-summary">@sample.Summary</p>
                        }
                        @if (sample.SampleTags.Count > 0)
                        {
                            <div class="tile-tags">
                                @foreach (var sampleTag in sample.SampleTags)
                                {
                                    <span class="chip chip-small">@sampleTag.Tag?.Name</span>
                                }
                            </div>
                        }
                    </div>
                </article>
            }
        </div>
    }
</div>

@code {
    private string _searchText = "";
    private readonly HashSet<Guid> _expandedTiles = [];
    private readonly HashSet<string> _selectedTags = [];
    private List<Tag> _allTags = [];
    private List<Sample> _samples = [];
    private CancellationTokenSource? _debounce;

    private bool _filtered => !string.IsNullOrWhiteSpace(_searchText) || _selectedTags.Count > 0;

    private List<CollectionWithCount> _collections = [];

    protected override async Task OnInitializedAsync()
    {
        _allTags = await Queries.GetAllTagsAsync();
        _collections = await Collections.GetAllWithCountsAsync();
        await RefreshAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("mocksmithDashboard.observeTiles");
    }

    private async Task RefreshAsync()
    {
        _samples = await Queries.SearchAsync(new SampleFilter(_searchText, [.. _selectedTags]));
    }

    private async Task EditSampleAsync(Guid sampleId)
    {
        var session = await Sessions.StartSessionFromSampleAsync(sampleId);
        Navigation.NavigateTo($"/sessions/{session.Id}");
    }

    private async Task EditVariantAsync(Guid variantId)
    {
        var session = await Sessions.StartSessionFromVariantAsync(variantId);
        Navigation.NavigateTo($"/sessions/{session.Id}");
    }

    private void ToggleVariants(Guid sampleId)
    {
        if (!_expandedTiles.Add(sampleId))
        {
            _expandedTiles.Remove(sampleId);
        }
    }

    private async Task OnSearchInputAsync(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? "";
        _debounce?.Cancel();
        var cts = new CancellationTokenSource();
        _debounce = cts;
        try
        {
            await Task.Delay(250, cts.Token);
            var results = await Queries.SearchAsync(new SampleFilter(_searchText, [.. _selectedTags]), cts.Token);
            // Only the latest debounce owner may publish, so a slow older search
            // can never overwrite results from a newer keystroke.
            if (ReferenceEquals(_debounce, cts) && !cts.IsCancellationRequested)
            {
                _samples = results;
            }
        }
        catch (OperationCanceledException)
        {
            // superseded by newer input
        }
    }

    private async Task ToggleTagAsync(string tagName)
    {
        _debounce?.Cancel();
        if (!_selectedTags.Add(tagName))
        {
            _selectedTags.Remove(tagName);
        }

        await RefreshAsync();
    }
}
